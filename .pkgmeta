# Configuration for the CurseForge / BigWigs packager
# https://addons.wowinterface.com/pkgmeta.html
#
# Repo layout: the addon files live at the REPOSITORY ROOT.
# The packager wraps them into a folder named by "package-as" (HotsNDots/),
# which is exactly what WoW and CurseForge expect.

package-as: HotsNDots

enable-nolib-creation: no

# This addon uses NO external libraries -> no "externals" needed.

# Files that should NOT go into the release zip:
ignore:
  - CURSEFORGE.md
  - HotsNDots-logo.png
  - HotsNDots.zip
  - build.ps1
  - .git
  - .github
  - .gitignore
